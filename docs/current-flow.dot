digraph OSREC {
graph [rankdir=TB, newrank=true, bgcolor="#f8fafc", pad="0.35", nodesep="0.35", ranksep="0.48", fontname="Helvetica", fontsize=22, label="OSREC — current flow, responsibilities and underlying tools\nSolid arrows: data / execution flow • Dashed arrows: workflow control", labelloc=t, compound=true];
node [shape=box, style="rounded,filled", color="#cbd5e1", fillcolor="white", fontname="Helvetica", margin="0.16,0.12"];
edge [color="#64748b", arrowsize=0.65, fontname="Helvetica", fontsize=11, fontcolor="#334155"];
orchestrators [fillcolor="#f1f5f9", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="4"><TR><TD><B>Select and run a replay workflow</B></TD></TR><TR><TD><FONT POINT-SIZE="11" COLOR="#1d4ed8">QEMU + Clang/LLVM: record a native scenario and build replay</FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">Native capture → port → slices → proof → test checkpoint chain</FONT></TD></TR><TR><TD><FONT POINT-SIZE="11" COLOR="#1d4ed8">Clang + local gateway + QMP: compile C and advance checkpoints</FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">C test frontend → import → shared stage engine</FONT></TD></TR><TR><TD><FONT POINT-SIZE="11" COLOR="#1d4ed8">ELF loader + state codec + QMP: import or continue saved execution</FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">Supplied ELF / checkpoint or --resume-checkpoint → shared stage engine</FONT></TD></TR></TABLE>>];
subgraph cluster_capture { label="1  NATIVE CAPTURE + KERNEL SLICES"; fontsize=24; fontname="Helvetica-Bold"; fontcolor="#2563eb"; style="rounded,filled"; color="#2563eb"; fillcolor="#eff6ff"; penwidth=2.5; margin=22; labelloc=t; labeljust=l;
linux [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD><B>Linux AArch64 native capture</B></TD></TR><TR><TD><FONT POINT-SIZE="11" COLOR="#1d4ed8">QEMU AArch64: execute native SVC calls and record results</FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">Native kernel boot binary: ARM64 Image + config<BR/>QEMU native SVC workload<BR/>Capture calls, raw returns, copied bytes, observed umask</FONT></TD></TR></TABLE>>, fillcolor="#dbeafe"];
ohos [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD><B>LiteOS-A test capture</B></TD></TR><TR><TD BGCOLOR="#fef3c7"><FONT POINT-SIZE="11" COLOR="#92400e"><B>TESTING PURPOSES: pinned kernel validation fixture</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="11" COLOR="#1d4ed8">Kernel instrumentation + QEMU Cortex-A7: record syscall boundaries</FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">Build / boot real ARMv7 kernel in QEMU<BR/>Instrumented syscall boundaries + independent user observations</FONT></TD></TR></TABLE>>, fillcolor="#dbeafe"];
port [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD><B>Validate capture and prepare reviewed port</B></TD></TR><TR><TD><FONT POINT-SIZE="11" COLOR="#1d4ed8">Reviewed adapters + JSON policies + SHA-256 identity checks</FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">Linux external bundle or built-in OHOS file adapter<BR/>Kernel C: selected syscall/helpers + reviewed model C<BR/>port.json + checkpoint policy</FONT></TD></TR></TABLE>>, fillcolor="#dbeafe"];
context [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD><B>Transform kernel state into per-session context</B></TD></TR><TR><TD><FONT POINT-SIZE="11" COLOR="#1d4ed8">Clang resolves declarations; OSREC rewrites kernel C</FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">Clang AST: mutable globals / local statics → context fields<BR/>References become ctx-&gt;field; callers pass ctx<BR/>Generate restoration helpers; ordinary locals stay on stack</FONT></TD></TR></TABLE>>, fillcolor="#dbeafe"];
codec [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD><B>Generate portable kernel checkpoint codec</B></TD></TR><TR><TD><FONT POINT-SIZE="11" COLOR="#1d4ed8">Clang provides target layout; OSREC generates codec C</FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">Reviewed policy covers every context field<BR/>Save scalar bytes and logical reference IDs / offsets<BR/>Load: reconstruct seeds → overlay saved values → rebind pointers</FONT></TD></TR></TABLE>>, fillcolor="#dbeafe"];
archive [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD><B>Build returning slices and proof image</B></TD></TR><TR><TD><FONT POINT-SIZE="11" COLOR="#1d4ed8">Clang cross-compiler + LLVM archive builder + LLD linker</FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">Clang / LLVM: AArch64 freestanding build + llvm-ar<BR/>Kernel library: slices.a<BR/>Kernel-slice proof: slices.elf / slices.bin + manifest.json</FONT></TD></TR></TABLE>>, fillcolor="#dbeafe"];
proof [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD><B>Validate kernel proof image</B></TD></TR><TR><TD><FONT POINT-SIZE="11" COLOR="#1d4ed8">QEMU Cortex-A53: compare ELF/raw runs from EL1 and EL3</FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">QEMU: ELF / raw × EL1 / EL3<BR/>Compare 128-byte results; retain verification-matrix.json</FONT></TD></TR></TABLE>>, fillcolor="#dbeafe"];
}
subgraph cluster_application { label="2  APPLICATION IMPORT + COMPOSITION"; fontsize=24; fontname="Helvetica-Bold"; fontcolor="#7c3aed"; style="rounded,filled"; color="#7c3aed"; fillcolor="#f5f3ff"; penwidth=2.5; margin=22; labelloc=t; labeljust=l;
c [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD><B>C application test frontend</B></TD></TR><TR><TD BGCOLOR="#fef3c7"><FONT POINT-SIZE="11" COLOR="#92400e"><B>TESTING PURPOSES: generate controlled application fixtures</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="11" COLOR="#1d4ed8">Clang + LLD + LLVM symbols: compile and derive metadata</FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">Application C + spec.json → application.elf + checkpoint.json<BR/>Derive entry / stack, SVC sites, exit boundary and assertions</FONT></TD></TR></TABLE>>, fillcolor="#e0e7ff"];
user [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD><B>Supplied application checkpoint</B></TD></TR><TR><TD><FONT POINT-SIZE="11">Application ELF: static AArch64 user program<BR/>Neutral user-state JSON<BR/>CPU frame, memory overlays, objects, ordered SVC PCs</FONT></TD></TR></TABLE>>, fillcolor="#e0e7ff"];
import [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD><B>Validate and import application</B></TD></TR><TR><TD><FONT POINT-SIZE="11" COLOR="#1d4ed8">ELF segment loader + instruction audit: validate and patch routes</FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">Check ELF hash, PT_LOAD mapping, permissions and instructions<BR/>Patch declared SVCs → BRKs; deduplicate repeated PCs<BR/>Output application original.elf / patched.elf<BR/>RAM payloads + route-plan.json</FONT></TD></TR></TABLE>>, fillcolor="#e0e7ff"];
compose [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD><B>Compose self-contained replay image</B></TD></TR><TR><TD><FONT POINT-SIZE="11" COLOR="#1d4ed8">Clang + LLD + LLVM utilities: link embedded code and state</FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">Embed application payloads, slices.a, loader, gateway, state<BR/>Generated runtime C: loader / gateway / replay driver<BR/>Combined replay: slices.elf / slices.bin (app + kernel slices)</FONT></TD></TR></TABLE>>, fillcolor="#e0e7ff"];
}
subgraph cluster_guest { label="3  FREESTANDING REPLAY RUNTIME"; fontsize=24; fontname="Helvetica-Bold"; fontcolor="#16a34a"; style="rounded,filled"; color="#16a34a"; fillcolor="#f0fdf4"; penwidth=2.5; margin=22; labelloc=t; labeljust=l;
restore [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD><B>Restore application and kernel state</B></TD></TR><TR><TD><FONT POINT-SIZE="11" COLOR="#1d4ed8">AArch64 frame runtime: restore CPU registers and application RAM</FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">Restore GPR / SIMD / FP / thread pointer / RAM<BR/>Initial kernel context or saved portable record</FONT></TD></TR></TABLE>>, fillcolor="#dcfce7"];
el0 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD><B>Execute application at EL0</B></TD></TR><TR><TD><FONT POINT-SIZE="11">Application prepares syscall arguments and consumes results<BR/>Kernel state persists across sequential calls</FONT></TD></TR></TABLE>>, fillcolor="#dcfce7"];
gateway [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD><B>Route declared syscall locally</B></TD></TR><TR><TD><FONT POINT-SIZE="11" COLOR="#1d4ed8">AArch64 BRK gateway: save the frame and dispatch calls</FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">BRK exception → save frame / validate expected route<BR/>Linux: x8 number, x0–x5 arguments; port defines ABI</FONT></TD></TR></TABLE>>, fillcolor="#dcfce7"];
syscall [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD><B>Execute selected original syscall body</B></TD></TR><TR><TD><FONT POINT-SIZE="11" COLOR="#1d4ed8">Returning slice/session runtime: execute code with reviewed models</FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">Reviewed dependency models + restored context<BR/>Check supported arguments / ordered boundary events as contracted</FONT></TD></TR></TABLE>>, fillcolor="#dcfce7"];
return [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD><B>Return to application</B></TD></TR><TR><TD><FONT POINT-SIZE="11">Result in x0; restore application frame<BR/>Resume at original SVC PC + 4</FONT></TD></TR></TABLE>>, fillcolor="#dcfce7"];
boundary [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD><B>Declared pause or exit boundary</B></TD></TR><TR><TD><FONT POINT-SIZE="11">Pause before next call at selected absolute ordinal<BR/>Final exit checks kernel completion + application memory assertions</FONT></TD></TR></TABLE>>, fillcolor="#dcfce7"];
}
subgraph cluster_chain { label="4  CHECKPOINTS + VERIFICATION"; fontsize=24; fontname="Helvetica-Bold"; fontcolor="#d97706"; style="rounded,filled"; color="#d97706"; fillcolor="#fffbeb"; penwidth=2.5; margin=22; labelloc=t; labeljust=l;
freeze [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD><B>Export joint checkpoint from stopped guest</B></TD></TR><TR><TD><FONT POINT-SIZE="11" COLOR="#1d4ed8">QMP memory observation + checkpoint validation: package stopped state</FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">QMP reads saved frame, RAM and kernel record externally<BR/>Output kernel.bin + checkpoint.json + application/ + manifest.json<BR/>Pin ordinal, completed-call history, generation and parent identity</FONT></TD></TR></TABLE>>, fillcolor="#fef3c7"];
resume [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD><B>Compose fresh image / resume remaining interval</B></TD></TR><TR><TD><FONT POINT-SIZE="11" COLOR="#1d4ed8">Clang/LLD + state codec: compose and restore a fresh image</FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">Restore portable state; rebind context-owned references<BR/>Alternate container addresses to exercise relocation<BR/>Final suffix completes without another intermediate checkpoint</FONT></TD></TR></TABLE>>, fillcolor="#fef3c7"];
verify [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD><B>Verify each stage and publish evidence</B></TD></TR><TR><TD><FONT POINT-SIZE="11" COLOR="#1d4ed8">QEMU execution matrix + artifact hashes: publish checked evidence</FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">ELF / raw × EL1 / EL3; resumed intervals execute twice<BR/>Check result bytes, artifacts, state identity and checkpoint lineage<BR/>Output stage-N/{image,qemu,checkpoint}, finish/, workflow.json</FONT></TD></TR></TABLE>>, fillcolor="#fef3c7"];
offline [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD><B>Offline verification of retained package</B></TD></TR><TR><TD><FONT POINT-SIZE="11" COLOR="#1d4ed8">SHA-256 checks + route/lineage validation: verify retained evidence</FONT></TD></TR><TR><TD><FONT POINT-SIZE="11">Recheck hashes, routes, ordinals, generations and saved evidence<BR/>Original construction inputs are no longer required</FONT></TD></TR></TABLE>>, fillcolor="#fef3c7"];
}
linux -> port [label="Native capture JSON + provenance\nCalls / returns / bytes / initial state", color="#2563eb", constraint=false];
ohos -> port [label="Kernel + user observations\nEntry state + ordered dependency events", color="#2563eb", constraint=false];
port -> context [label="Kernel C sources + reviewed model headers\nSelected original bodies / reviewed dependencies", color="#2563eb", constraint=false];
context -> codec [label="Rewritten kernel C + slice_context.h\ncontext-plan.json + reviewed field policy", color="#2563eb", constraint=false];
codec -> archive [label="Generated runtime C: slice_codec.c + schema\nTransformed closure / adapter / embedded capture", color="#2563eb", constraint=false];
archive -> proof [label="Kernel-slice proof ELF / raw + manifest.json\nExpected proof result / archive identity", color="#2563eb", constraint=false];
c -> import [label="Application ELF: application.elf + checkpoint.json\nDerived CPU / memory / route metadata", color="#2563eb", constraint=false];
user -> import [label="Application ELF bytes + user-state JSON\nSaved frame / RAM overlays / SVC history", color="#2563eb", constraint=false];
proof -> compose [label="Verified kernel package: slices.a\nSources / initial state / codec / manifest", color="#2563eb", constraint=false];
import -> compose [label="Application ELF: original.elf + patched.elf\nRAM payloads / frame / route-plan.json", color="#2563eb", constraint=false];
compose -> restore [label="Combined replay ELF / raw image\nApplication bytes / frame / initial kernel state", color="#2563eb", constraint=false];
restore -> el0 [label="Restored PC / SP / GPR / SIMD / FP\nUser RAM + thread pointer", color="#2563eb", constraint=false];
el0 -> gateway [label="BRK trap + live application frame\nSyscall number / arguments / next ordinal", color="#2563eb", constraint=false];
gateway -> syscall [label="Validated syscall invocation\nContext pointer + arguments + user memory", color="#2563eb", constraint=false];
syscall -> return [label="Computed return value + updated state\nUser-buffer writes / dependency progress", color="#2563eb", constraint=false];
return -> el0 [label="x0 result + restored frame\nPC = original SVC PC + 4; user writes retained", color="#2563eb", constraint=false];
el0 -> boundary [label="Current CPU / RAM + syscall ordinal\nPause route or declared exit PC", color="#2563eb", constraint=false];
boundary -> freeze [label="Paused frame + RAM + encoded kernel record\nExternal QMP dumps in pause-records/", color="#b45309", fontcolor="#92400e", penwidth=1.5, constraint=false];
freeze -> resume [label="Joint package: kernel.bin + application/\ncheckpoint.json / manifest / generation / parent hash", color="#b45309", fontcolor="#92400e", penwidth=1.5, constraint=false];
resume -> restore [xlabel="Fresh image + joint snapshot\nSaved ordinal / values + rebound references", color="#b45309", fontcolor="#92400e", penwidth=1.5, constraint=false];
compose -> verify [label="Image + manifest + expected results\nCombined replay ELF / raw + construction artifacts", color="#2563eb", constraint=false];
resume -> verify [label="Resumed image + input checkpoint identity\nExpected interval / state / assertions", color="#2563eb", constraint=false];
boundary -> verify [label="Final result block + assertion status\nCompletion / model-transcript checks per port", color="#2563eb", constraint=false];
verify -> offline [label="workflow.json + matrix reports + hashes\nImages / result bytes / checkpoint lineage", color="#2563eb", constraint=false];
orchestrators -> linux [label="Native capture or existing observations", style=dashed, color="#94a3b8", constraint=false];
orchestrators -> c [label="Test application C, contract and pause positions", style=dashed, color="#94a3b8", constraint=false];
orchestrators -> user [label="Application ELF and saved user state\nor matching joint checkpoint", style=dashed, color="#94a3b8", constraint=false];
cheatsheet [shape=box, fillcolor="#ffffff", color="#94a3b8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#e2e8f0"><FONT POINT-SIZE="15"><B>Quick reference</B></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="12"><B>Shared stage engine</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Common host workflow for test-C and supplied-ELF inputs:<BR ALIGN="LEFT"/>build each image, verify it, save state and continue.</FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="12"><B>QEMU</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Emulates the target CPU and machine for native<BR ALIGN="LEFT"/>capture and functional replay validation.</FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="12"><B>QMP</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">QEMU Machine Protocol: a host control channel used<BR ALIGN="LEFT"/>to inspect stopped guest memory for checkpoint export.</FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="12"><B>Clang / AST</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">C compiler and typed Abstract Syntax Tree used to<BR ALIGN="LEFT"/>identify declarations, types and state references.</FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="12"><B>LLVM / LLD</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">LLVM compiles code and supplies binary utilities.<BR ALIGN="LEFT"/>LLD links selected code and state into the executable.</FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="12"><B>Context / codec</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Context owns mutable session state. A codec saves<BR ALIGN="LEFT"/>selected values and rebuilds references during restore.</FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="12"><B>ELF / PT_LOAD</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Executable format and loadable segments describing<BR ALIGN="LEFT"/>addresses, file bytes and zero-filled memory extents.</FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="12"><B>EL0 / EL1 / EL3</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">AArch64 privilege levels: app at EL0, gateway at EL1.<BR ALIGN="LEFT"/>Verification also tests a more privileged EL3 start.</FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="12"><B>SVC / BRK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Native syscall instruction / local breakpoint trap.<BR ALIGN="LEFT"/>Declared SVC sites become BRKs routed by the gateway.</FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="12"><B>Ordinal</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Absolute completed-call count: identifies the next<BR ALIGN="LEFT"/>syscall and the position at which replay resumes.</FONT></TD></TR></TABLE>>];
artifact_reference [shape=box, fillcolor="#ffffff", color="#94a3b8", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="6"><TR><TD COLSPAN="2" BGCOLOR="#e2e8f0"><FONT POINT-SIZE="13"><B>C / ELF: which side?</B></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="12"><B>Kernel C</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Selected original syscall/helper bodies plus<BR ALIGN="LEFT"/>reviewed dependency-model C; not the whole kernel.</FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="12"><B>Application C</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">User-program source compiled into application.elf.<BR ALIGN="LEFT"/>Separate from kernel C and generated runtime C.</FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="12"><B>Generated C</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Replay support: context helpers, codecs, loaders<BR ALIGN="LEFT"/>and adapters; not original application/kernel source.</FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="12"><B>Application ELF</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">User executable: application.elf or supplied ELF;<BR ALIGN="LEFT"/>import keeps original.elf and patches patched.elf.</FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="12"><B>Proof / replay ELF</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Proof: kernel slices + runtime + test driver.<BR ALIGN="LEFT"/>Replay: application payload + kernel slices + runtime.</FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="12"><B>slices.elf name</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Used in both proof and composed-image directories.<BR ALIGN="LEFT"/>Its role depends on the stage; neither is a full kernel.</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#fef3c7"><FONT POINT-SIZE="12" COLOR="#92400e"><B>Testing purposes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP"><FONT POINT-SIZE="12"><B>LiteOS / C frontend</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">LiteOS validates the kernel-port and replay path.<BR ALIGN="LEFT"/>The C frontend creates controlled application fixtures.</FONT></TD></TR></TABLE>>];
// Compact two-row arrangement of the four stages; invisible links are layout only.
{rank=same; linux; ohos; c; user;}
{rank=same; port; context; import;}
{rank=same; codec; archive;}
{rank=same; proof; compose;}
{rank=same; restore; el0; freeze; resume;}
{rank=same; gateway; syscall; verify; offline;}
{rank=same; return; boundary;}
{rank=same; cheatsheet; artifact_reference;}
edge [style=invis, weight=100];
orchestrators -> linux;
linux -> ohos -> c -> user;
linux -> port -> codec -> proof -> restore -> gateway -> return -> cheatsheet;
port -> context;
c -> import -> compose -> freeze -> verify -> artifact_reference;
codec -> archive;
proof -> compose;
restore -> el0 -> freeze -> resume;
gateway -> syscall -> verify -> offline;
return -> boundary;
cheatsheet -> artifact_reference;
}
