digraph flow {
graph [rankdir=LR, bgcolor="#f8fafc", pad="0.3", nodesep="0.4", ranksep="0.6", fontname="Helvetica", fontsize=20, labelloc=t, label="01  Capture → reviewed port → session context\nLinux minimal-profile JSON fields shown; capture schemas and dependency models are port-specific."];
node [shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e1", fontname="Helvetica", margin="0.08"];
edge [color="#2563eb", fontcolor="#334155", fontname="Helvetica", fontsize=11, arrowsize=0.7];
capture [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>Native capture JSON</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#1d4ed8">tools/capture_linux_aarch64.py</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>capture.json • osrec-linux-aarch64-capture-v1</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">initial</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">pid, tgid, ppid, uids[3], gids[3], umask</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">calls[]</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Ordered syscall observations</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">number</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Linux syscall number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">args[3]</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Captured integers; output pointers normalized<BR ALIGN="LEFT"/>to app_words offsets / invalid-address sentinels</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">raw_bits</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Raw 64-bit syscall result bits</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">words[8]</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Observed uint32 user-buffer contents</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">umask_after</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Mask observed after each call</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>capture.manifest.json</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">identity</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Kernel release + Image / config hashes</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">capture_sha256</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Exact capture JSON identity</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">reviewed_source_identity</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Selected upstream source identity</FONT></TD></TR></TABLE>>];
port [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>Prepared kernel port</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#1d4ed8">tools/prepare_linux_aarch64_port.py<BR/>tools/slice_port_bundle.py</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>port.json • osrec-kernel-slice-port-v1</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">roots[]</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">number, function, arguments</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">argument_width</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Port-defined syscall scalar width</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">bundle</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Hash-bound adapter / proof / construction inputs</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>Prepared source closure</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">syscalls.c</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Selected original syscall bodies</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">models.c / model.h</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Reviewed dependency and type definitions</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">adapter.c / capture.c</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Returning session adapter + embedded observations</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">checkpoint-policy.json</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Exact type + policy for every context field</FONT></TD></TR></TABLE>>];
context [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>Transformed per-session state</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#1d4ed8">tools/contextify_slice.py</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>slice_context.h • generated C, not wire data</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">struct osrec_kernel_context</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Owns moved globals and supported local statics</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">state access</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">global → ctx-&gt;field</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">direct calls</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">callee(args) → callee(ctx, args)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">osrec_context_restore(ctx)</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Zero storage; reconstruct original initializers<BR ALIGN="LEFT"/>Owned pointer seeds bind to this context</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>context-plan.json</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">fields</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">name + exact target C type</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">context_functions</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Functions requiring a context parameter</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">function_dependencies</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Direct-call dependency graph</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">input_sha256</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Exact prepared source / header hashes</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>Boundaries</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">adapter required</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Indirect calls, mutable TLS / volatile state,<BR ALIGN="LEFT"/>external mutable state, unsupported declarations</FONT></TD></TR></TABLE>>];
capture -> port [label="Observed values\n+ provenance"];
port -> context [label="Prepared C closure\n+ owned headers"];
}
