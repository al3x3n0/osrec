digraph flow {
graph [rankdir=LR, bgcolor="#f8fafc", pad="0.3", nodesep="0.4", ranksep="0.6", fontname="Helvetica", fontsize=20, labelloc=t, label="02  Application checkpoint → route package → image\nJSON fields are schema projections. Hex strings encode bytes; ELF PT_LOAD segments define the initial image."];
node [shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e1", fontname="Helvetica", margin="0.08"];
edge [color="#2563eb", fontcolor="#334155", fontname="Helvetica", fontsize=11, arrowsize=0.7];
input [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>User-space input checkpoint</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#1d4ed8">tools/compile_c_application.py or supplied ELF</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>checkpoint.json • osrec-aarch64-application-checkpoint-v1</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">elf_sha256</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">SHA-256 of exact application.elf</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">frame</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">x[31], sp, pc, pstate, v[32] as [lo,hi],<BR ALIGN="LEFT"/>fpcr, fpsr, tpidr_el0, tpidrro_el0</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">calls[]</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">{pc}: ordered active syscall instruction addresses</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">first_ordinal / completed_calls[]</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Completed prefix count / {pc} history on resume</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">exit</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">{pc, original}: expected 4 original instruction bytes</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">snapshots[]</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">{address, data}: recorded non-code byte overlays</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">extra_memory[]</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">{address, bytes, permissions}: stack / heap ranges</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">objects[]</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">{address, bytes, id}: memory object identities</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">assertions[]</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">{address, data}: expected final memory bytes</FONT></TD></TR></TABLE>>];
routes [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>Validated route package</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#1d4ed8">tools/import_application_checkpoint.py</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>route-plan.json • osrec-aarch64-application-routes-v1</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">frame</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Normalized complete initial CPU frame</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">loads[]</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">address, file_bytes, memory_bytes, flags,<BR ALIGN="LEFT"/>file, sha256, plus file_offset for ELF segments</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">sites[]</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">ordinal, svc_pc, continuation_pc = svc_pc + 4</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">patches[]</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">address, original, replacement, kind</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">regions[]</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">User-memory partitions with permissions / object IDs</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">assertions / exit_pc</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Final memory checks and explicit exit boundary</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>Retained files</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">original.elf / patched.elf</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Original image / patched executable image</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">memory payloads</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">ELF bytes + zero-filled BSS + snapshot overlays</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">generated C / header</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Loader data and ordered local route table</FONT></TD></TR></TABLE>>];
image [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>Self-contained replay image</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#1d4ed8">tools/export_application_replay.py</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>ELF / raw + manifest.json</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">slices.elf</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">ELF entry and PT_LOAD mapping are authoritative</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">slices.bin</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Raw load form of the replay image</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">embedded inputs</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Application RAM / frame, route table, slices.a,<BR ALIGN="LEFT"/>initial context or saved joint kernel record</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">manifest</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Image / archive / source / application hashes,<BR ALIGN="LEFT"/>expected result and target observations</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>Transformation</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">SVC patch</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Declared SVC → BRK #0x5353</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">exit patch</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Declared exit → BRK #0x5354</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">repeated PC</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">One physical patch; multiple ordered route entries</FONT></TD></TR></TABLE>>];
input -> routes [label="ELF + JSON\nValidate / patch / normalize"];
routes -> image [label="Payloads + routes + frame\nCombine with kernel archive"];
}
