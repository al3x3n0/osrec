digraph flow {
graph [rankdir=LR, bgcolor="#f8fafc", pad="0.3", nodesep="0.4", ranksep="0.6", fontname="Helvetica", fontsize=20, labelloc=t, label="03  Local gateway → returning slice ABI → application\nThese are in-memory C structures, not portable serialized records. Pointer and size_t layout follows the target ABI."];
node [shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e1", fontname="Helvetica", margin="0.08"];
edge [color="#2563eb", fontcolor="#334155", fontname="Helvetica", fontsize=11, arrowsize=0.7];
frame [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>Application frame and route</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#1d4ed8">include/osrec/aarch64_frame.h<BR/>runtime/aarch64_gateway.S / .c</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>osrec_aarch64_frame • 808 bytes</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">x[31]</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">31 × u64 general registers</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">sp / pc / pstate</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">3 × u64</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">v[32]</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">32 × {lo:u64, hi:u64}</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">fpcr / fpsr</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">2 × u32</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">tpidr_el0 / tpidrro_el0</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">2 × u64</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>osrec_aarch64_site</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">ordinal</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">u64: expected absolute call ordinal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">svc_pc / continuation_pc</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">u64 instruction addresses</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">memory</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">osrec_user_memory view</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>Linux register mapping</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">x8</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Syscall number</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">x0–x5</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Arguments</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">x0 on return</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Raw result</FONT></TD></TR></TABLE>>];
invoke [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>Slice invocation and memory</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#1d4ed8">include/osrec/syscall_slice.h<BR/>osrec_slice_execute(session, invocation, result)</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>osrec_slice_invocation</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">ordinal / number</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">2 × u64</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">args[6]</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">6 × u64</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">memory</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">osrec_user_memory</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>osrec_user_memory</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">regions</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">const osrec_user_region *</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">count</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">size_t</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>osrec_user_region</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">user_address</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">u64 application address</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">image_address</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">unsigned char * to mapped replay bytes</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">bytes</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">size_t range length</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">permissions</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">u32: READ=1, WRITE=2 (RW=3)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">object_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">u32 logical memory identity</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>State supplied separately</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">session.state</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Caller-owned kernel context pointer</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">session.next</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">u64 expected invocation ordinal</FONT></TD></TR></TABLE>>];
result [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>Returning result and effects</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#1d4ed8">runtime/syscall_slice.c<BR/>runtime/aarch64_frame.c</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>osrec_slice_result</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">raw</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">i64 raw syscall return</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">status / diagnostic</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">2 × u32</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">ordinal</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">u64 invocation ordinal</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>Runtime status codes</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">0 / 1 / 2</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">OK / BAD_INPUT / BUSY</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">3 / 4 / 5</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">DIVERGED / POISONED / COMPLETE</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>Successful return</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">frame.x[result_register]</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Install raw result (Linux x0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">frame.pc</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">svc_pc + 4</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">user-memory effects</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Writes retained in mapped application RAM</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">kernel-context effects</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Updates retained for the next syscall</FONT></TD></TR></TABLE>>];
frame -> invoke [label="Save live frame\nValidate route / extract registers"];
invoke -> result [label="Original body + reviewed models\nCompute return and effects"];
}
