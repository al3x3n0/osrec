digraph flow {
graph [rankdir=LR, bgcolor="#f8fafc", pad="0.3", nodesep="0.4", ranksep="0.6", fontname="Helvetica", fontsize=20, labelloc=t, label="04  Kernel checkpoint record • exact wire layout\nAll header integers are little-endian. Payload is schema-bound AArch64 little-endian data; no raw context padding."];
node [shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e1", fontname="Helvetica", margin="0.08"];
edge [color="#2563eb", fontcolor="#334155", fontname="Helvetica", fontsize=11, arrowsize=0.7];
header [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>kernel.bin: fixed header</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#1d4ed8">runtime/slice_checkpoint.c<BR/>OSREC_SLICE_CHECKPOINT_ABI = 1</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>Byte offset • type • meaning</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">0–7</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">u64 magic: 0x31504b434552534f<BR ALIGN="LEFT"/>ASCII bytes: OSRECKP1</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">8–11</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">u32 version = 1</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">12–15</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">u32 total record bytes = 64 + payload_bytes</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">16–47</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">32 raw schema SHA-256 bytes</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">48–55</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">u64 next absolute syscall ordinal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">56–63</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">u64 FNV-1a checksum<BR ALIGN="LEFT"/>Record bytes excluding checksum field</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">64 onward</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Generated field payload</FONT></TD></TR></TABLE>>];
payload [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>Schema-defined payload</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#1d4ed8">tools/slice_checkpoint_codec.py<BR/>osrec-slice-checkpoint-schema-v1 policy</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>Field policy → wire encoding</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">persist</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Integer / byte-array bytes packed in field order</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">context_reference</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">u64 field-local object ID; zero = null</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">context_buffer_reference</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">u64 buffer ID + u64 byte offset<BR ALIGN="LEFT"/>Canonical null = (0,0)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">self_reference</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">No wire bytes; rebuild canonical owned link</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">transient</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">No wire bytes; reconstruct initial / scratch state</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">members / elements</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Recursively classify struct / fixed-array fields</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>Codec manifest • osrec-slice-checkpoint-codec-v1</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">fields[]</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">type, policy, context offset / bytes,<BR ALIGN="LEFT"/>wire_offset and reference targets where applicable</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">schema_sha256</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Identity of layout, policy and construction</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">payload_bytes / record_bytes</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Generated size; payload ≤ 65,536 bytes</FONT></TD></TR></TABLE>>];
load [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>Validated restore into fresh context</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#1d4ed8">osrec_slice_checkpoint_load()</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>Validation before destination update</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">header</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Magic / version / size / schema / checksum</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">ordinal</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Must not exceed selected call count</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">references</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">IDs / offsets / nullability / alignment / bounds</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">port callback</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Validate temporary state at quiescent boundary</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>Successful reconstruction</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">1. restore</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Recreate initial context seeds</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">2. overlay</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Install persisted scalar and array bytes</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">3. rebind</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">IDs / offsets → destination context pointers</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">4. resume</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Install saved session.next ordinal</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>Failure contract</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">Rejected load</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Session and destination state stay unchanged</FONT></TD></TR></TABLE>>];
header -> payload [label="Header binds payload\nto exact codec schema"];
payload -> load [label="Decode saved values\nRebind logical references"];
}
