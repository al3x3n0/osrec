digraph flow {
graph [rankdir=LR, bgcolor="#f8fafc", pad="0.3", nodesep="0.4", ranksep="0.6", fontname="Helvetica", fontsize=20, labelloc=t, label="05  Paused guest → joint package → fresh-image continuation\nApplication CPU/RAM and kernel context are separate data formats, linked by ordinal and hash-bound identities."];
node [shape=box, style="rounded,filled", fillcolor="white", color="#cbd5e1", fontname="Helvetica", margin="0.08"];
edge [color="#2563eb", fontcolor="#334155", fontname="Helvetica", fontsize=11, arrowsize=0.7];
dumps [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>Stopped-guest observations</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#1d4ed8">tools/application_pause.py: observation_plan<BR/>QMP memory reads outside guest execution</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>pause-records/</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">frame.bin</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">808 bytes: saved application CPU frame</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">kernel.bin</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">64-byte header + generated kernel payload</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">memory-N.bin</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Raw bytes for every imported memory load range</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>Pause contract</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">frame.pc</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Next declared SVC; paused call has not executed</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">kernel next ordinal</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Absolute number of completed calls</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">producer manifest</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Dump hashes / addresses / sizes / proof status</FONT></TD></TR></TABLE>>];
joint [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>Portable joint checkpoint package</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#1d4ed8">tools/application_pause.py: freeze / verify_joint</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>Files</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">kernel.bin</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Verified portable kernel record</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">checkpoint.json</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Updated user frame / writable RAM snapshots<BR ALIGN="LEFT"/>Remaining calls + completed_calls history</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">application/</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Original ELF + newly imported route package</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">manifest.json</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">osrec-joint-application-kernel-checkpoint-v1</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>Joint manifest key fields</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">pause_ordinal / total_calls</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Execution position and bounded sequence length</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">generation</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Checkpoint generation counter</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">input_checkpoint_manifest_sha256</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Parent identity, or null for first checkpoint</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">kernel_schema_sha256</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Codec identity</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">kernel_archive_sha256</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Kernel code identity</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">application_manifest_sha256</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">User route / frame / memory identity</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">artifact_hashes</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Hashes for retained checkpoint package files</FONT></TD></TR></TABLE>>];
next [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2" CELLPADDING="7"><TR><TD COLSPAN="2" BGCOLOR="#dbeafe"><B>Fresh image and retained evidence</B></TD></TR><TR><TD COLSPAN="2"><FONT POINT-SIZE="10" COLOR="#1d4ed8">tools/application_checkpoint_chain.py<BR/>tools/export_application_replay.py</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>Composition</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">inputs</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Matching slices.a + joint checkpoint package</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">restoration</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">CPU / RAM restored; kernel references rebound</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">active routes</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Only remaining interval / final suffix</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">execution</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">State persists between calls in this image</FONT></TD></TR><TR><TD COLSPAN="2" BGCOLOR="#f1f5f9"><B>Published chain artifacts</B></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">stage-N/image</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Self-contained ELF / raw + manifest</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">stage-N/qemu</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">ELF / raw × EL1 / EL3 verification matrix</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">stage-N/checkpoint</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Next joint checkpoint if paused</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">finish/</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Final suffix image and verification evidence</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Courier" POINT-SIZE="11">workflow.json</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">Intervals / generations / identities / hashes</FONT></TD></TR></TABLE>>];
dumps -> joint [label="Verify frame / RAM / record\nNormalize snapshot into package"];
joint -> next [label="Hash-bound saved state\nCompose and execute suffix"];
}
