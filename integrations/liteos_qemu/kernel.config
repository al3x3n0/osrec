
#
# Compiler
#
# LOSCFG_COMPILER_GCC is not set
LOSCFG_COMPILER_CLANG_LLVM=y
LOSCFG_LLVM_TARGET="arm-none-eabi"
LOSCFG_COMPILE_DEBUG=y
LOSCFG_COMPILE_OPTIMIZE=y
LOSCFG_COMPILE_OPTIMIZE_SIZE=y
# LOSCFG_COMPILE_LTO is not set
# end of Compiler

#
# Platform
#
LOSCFG_PLATFORM="virt"
LOSCFG_PRODUCT_NAME="arm_virt"
LOSCFG_DEVICE_COMPANY="qemu"
# LOSCFG_PLATFORM_HI3516DV300 is not set
# LOSCFG_PLATFORM_HI3518EV300 is not set
LOSCFG_PLATFORM_QEMU_ARM_VIRT_CA7=y
# LOSCFG_PLATFORM_STM32MP157 is not set
LOSCFG_PRODUCT_QEMU_ARM=y
LOSCFG_BOARD_CONFIG_PATH="device/qemu/arm_virt/liteos_a/board"
# LOSCFG_HRTIMER_ENABLE is not set
LOSCFG_ARCH_ARM=y
LOSCFG_ARCH_ARM_AARCH32=y
LOSCFG_ARCH_ARM_V7A=y
LOSCFG_ARCH_ARM_VER="armv7-a"
LOSCFG_ARCH_FPU_VFP_V4=y
LOSCFG_ARCH_FPU_VFP_D32=y
LOSCFG_ARCH_FPU_VFP_NEON=y
LOSCFG_ARCH_FPU="neon-vfpv4"
LOSCFG_ARCH_CORTEX_A7=y
LOSCFG_ARCH_CPU="cortex-a7"
LOSCFG_ARCH_GIC_V2=y

#
# Extra Configurations
#
# LOSCFG_ARCH_FPU_DISABLE is not set
LOSCFG_IRQ_USE_STANDALONE_STACK=y
# LOSCFG_QUICK_START is not set
# end of Platform

#
# Kernel
#
# LOSCFG_KERNEL_SMP is not set
LOSCFG_KERNEL_MMU=y
LOSCFG_KERNEL_VM=y
LOSCFG_KERNEL_SYSCALL=y
# LOSCFG_PAGE_TABLE_FINE_LOCK is not set
LOSCFG_KERNEL_EXTKERNEL=y
# LOSCFG_KERNEL_CPPSUPPORT is not set
LOSCFG_KERNEL_CPUP=y
LOSCFG_CPUP_INCLUDE_IRQ=y
# LOSCFG_KERNEL_DYNLOAD is not set
LOSCFG_KERNEL_PM=y
# LOSCFG_KERNEL_VDSO is not set
LOSCFG_KERNEL_SHM=y
# LOSCFG_KERNEL_LITEIPC is not set
# LOSCFG_KERNEL_PIPE is not set
# LOSCFG_KERNEL_PLIMITS is not set
# LOSCFG_BASE_CORE_HILOG is not set
# LOSCFG_KERNEL_HOOK is not set
# LOSCFG_KERNEL_CONTAINER is not set
# LOSCFG_BLACKBOX is not set
# LOSCFG_HIDUMPER is not set
# LOSCFG_KERNEL_PERF is not set
# LOSCFG_KERNEL_LMS is not set
# LOSCFG_HILOG is not set
LOSCFG_HILOG_BUFFER_SIZE=16384
# LOSCFG_ENABLE_KERNEL_TEST is not set
# end of Kernel

#
# Lib
#
LOSCFG_LIB_LIBC=y
# LOSCFG_LIBC_NEWLIB is not set
LOSCFG_LIBC_MUSL=y
# LOSCFG_LIB_ZLIB is not set
# end of Lib

#
# Compat
#
LOSCFG_COMPAT_POSIX=y
LOSCFG_COMPAT_BSD=y
LOSCFG_COMPAT_LINUXKPI=y
# end of Compat

#
# FileSystem
#
LOSCFG_FS_VFS=y
# LOSCFG_FS_VFS_BLOCK_DEVICE is not set
LOSCFG_FILE_MODE=y
# LOSCFG_ENABLE_READ_BUFFER is not set
LOSCFG_MAX_VNODE_SIZE=512
LOSCFG_MAX_PATH_CACHE_SIZE=512
# LOSCFG_FS_FAT is not set
LOSCFG_FS_RAMFS=y
# LOSCFG_FS_ROMFS is not set
LOSCFG_FS_PROC=y
# LOSCFG_PROC_PROCESS_DIR is not set
# end of FileSystem

#
# Net
#
# LOSCFG_NET_LWIP_SACK is not set
# end of Net

#
# Debug
#
# LOSCFG_GDB is not set
LOSCFG_PLATFORM_ADAPT=y
# LOSCFG_ENABLE_OOM_LOOP_TASK is not set
LOSCFG_ENABLE_MAGICKEY=y
# LOSCFG_THUMB is not set
# LOSCFG_PLATFORM_DVFS is not set
# LOSCFG_SAVE_EXCINFO is not set
LOSCFG_DEBUG_VERSION=y
# LOSCFG_DEBUG_KERNEL is not set
# LOSCFG_SHELL is not set
# LOSCFG_SCHED_DEBUG is not set
# LOSCFG_USER_INIT_DEBUG is not set
# LOSCFG_MEM_DEBUG is not set
# end of Debug

#
# Driver
#
LOSCFG_DRIVERS=y
# LOSCFG_DRIVERS_USB is not set
# LOSCFG_DRIVERS_HDF is not set
LOSCFG_PLATFORM_UART_WITHOUT_VFS=y
# LOSCFG_PLATFORM_NO_UART is not set
# LOSCFG_DRIVERS_PLATFORM_CHAR_DEVICE is not set
# LOSCFG_DRIVERS_MTD is not set
# LOSCFG_DRIVERS_EMMC is not set
# LOSCFG_DRIVERS_MEM is not set
# LOSCFG_DRIVERS_QUICKSTART is not set
# LOSCFG_DRIVERS_RANDOM is not set
# LOSCFG_DRIVERS_VIDEO is not set
# LOSCFG_DRIVERS_HIEVENT is not set
# end of Driver

#
# Security
#
LOSCFG_SECURITY=y
LOSCFG_SECURITY_CAPABILITY=y
LOSCFG_SECURITY_VID=y
# LOSCFG_SECURITY_BOOT is not set
# end of Security

#
# Test
#
# end of Test

#
# Stack Smashing Protector (SSP) Compiler Feature
#
LOSCFG_CC_NO_STACKPROTECTOR=y
# LOSCFG_CC_STACKPROTECTOR is not set
# LOSCFG_CC_STACKPROTECTOR_STRONG is not set
# LOSCFG_CC_STACKPROTECTOR_ALL is not set
# end of Stack Smashing Protector (SSP) Compiler Feature
