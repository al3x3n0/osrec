+static uint32_t pair_q(unsigned first,unsigned second,size_t offset,int load)
+{
+    return (load?0xa9400000u:0xa9000000u)|((offset/8)<<15)|
+           (second<<10)|(SHADOW_BASE<<5)|first;
+}
