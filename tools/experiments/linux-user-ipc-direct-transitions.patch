+static void emit_fixed_gateways(struct lk_el0_native *n,const uint32_t *entry)
+{
+    const size_t saved=offsetof(struct lk_el0_native,fixed_saved_x16);
+    const size_t site=offsetof(struct lk_el0_native,fixed_svc_pc);
+    _Static_assert(offsetof(struct lk_el0_native,fixed_saved_x16)<512 &&
+                   offsetof(struct lk_el0_native,fixed_svc_pc)<512 &&
+                   offsetof(struct lk_el0_native,fixed_saved_x17)==
+                       offsetof(struct lk_el0_native,fixed_saved_x16)+8 &&
+                   offsetof(struct lk_el0_native,fixed_return_thunk)==
+                       offsetof(struct lk_el0_native,fixed_svc_pc)+8,"paired gateway offsets");
+    const size_t first=(n->app.count+1)&~1ull;
+    if(first+n->app.count*FIXED_GATE_WORDS>n->app.size/4)
+        stop(OSREC_STOP_UNSUPPORTED,n->context->pc,n->app.count,n->app.size);
+    uint32_t *gateways=n->gateways;
+    for(size_t i=0;i<n->app.count;i++) {
+        const struct application_site *a=n->app_sites+i;
+        if(a->kind || a->word!=0xd4000001u)
+            stop(OSREC_STOP_UNSUPPORTED,a->pc,a->word,a->kind);
+        uint32_t *slot=gateways+first+i*FIXED_GATE_WORDS;
+        gateways[i]=direct_branch(a->gateway,(uintptr_t)slot);
+        slot[0]=pair_q(16,17,saved,0);
+        slot[1]=0x58000010u|(7u<<5); /* ldr x16, slot[8] */
+        slot[2]=0x10000011u|(4u<<5); /* adr x17, slot[6] */
+        slot[3]=pair_q(16,17,site,0);
+        slot[4]=0x58000010u|(6u<<5); /* ldr x16, slot[10] */
+        slot[5]=0xd61f0200u;         /* br x16 */
+        slot[6]=pair_q(16,17,saved,1);
+        slot[7]=direct_branch((uintptr_t)(slot+7),a->pc+4);
+        uint64_t address=(uintptr_t)entry;
+        memcpy(slot+8,&a->pc,sizeof a->pc);
+        memcpy(slot+10,&address,sizeof address);
+    }
 }

