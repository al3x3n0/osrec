+/* The copied sequences use only local branches and offsets from x18.
+ * At ERET x0 holds the restored syscall result, so the return sequence
+ * can complete the event directly. A syscall that does not return
+ * leaves its event incomplete.
+ * The low-address syscall gateways supply a site and a return landing pad. */
+static __attribute__((always_inline)) inline uint32_t *emit_fixed_entry(
+    struct lk_el0_native *n,uint32_t *out,int anchor_sets_daif)
+{
+    const uint32_t *begin,*end,*ssbs,*branch;
+    __asm__ volatile(
+        "b 9f\n"
+        "1:\n"
+        "ldp x17,x16,[x18,%c[event_end]]\n"
+        "sub x17,x17,x16\n"
+        "cbz x17,8f\n"
+        "stp xzr,x8,[x16]\n"
+        "stp x0,x1,[x16,#16]\n"
+        "stp x2,x3,[x16,#32]\n"
+        "stp x4,x5,[x16,#48]\n"
+        "ldr x17,[x18,%c[resume]]\n"
+        "sub x17,x17,#4\n"
+        "str x17,[x16,#80]\n"
+        "add x17,x16,%c[event_size]\n"
+        "stp x17,x16,[x18,%c[cursor]]\n"
+        "ldr x17,[x18,%c[resume]]\n"
+        "mrs x16,nzcv\n"
+        "3: nop\n" /* Optional SSBS from the captured user PSTATE. */
+        "stp x16,x17,[x18,%c[spsr]]\n"
+        "mov x16,#0x56000000\n"
+        "str x16,[x18,%c[esr]]\n"
+        "mov x16,sp\n"
+        "str x16,[x18,%c[sp_el0]]\n"
+        "ldr x16,[x18,%c[sp_el1]]\n"
+        "mov sp,x16\n"
+        ".if %c[anchor_sets_daif]\n"
+        "str x18,[x18,%c[daif]]\n"
+        ".else\n"
+        "mov x16,#0x3c0\n"
+        "str x16,[x18,%c[daif]]\n"
+        ".endif\n"
+        "ldp x16,x17,[x18,%c[saved16]]\n"
+        "4: nop\n" /* Direct branch to the captured EL0 vector. */
+        "8:\n"
+        "ldp x16,x17,[x18,%c[saved16]]\n"
+        "brk #0xf07\n"
+        "2:\n"
+        "9:\n"
+        "adr %0,1b\n"
+        "adr %1,2b\n"
+        "adr %2,3b\n"
+        "adr %3,4b\n"
+        : "=&r"(begin),"=&r"(end),"=&r"(ssbs),"=&r"(branch)
+        : [anchor_sets_daif] "i"(anchor_sets_daif),
+          [saved16] "i"(offsetof(struct lk_el0_native,fixed_saved_x16)),
+          [event_end] "i"(offsetof(struct lk_el0_native,event_end)),
+          [cursor] "i"(offsetof(struct lk_el0_native,event_cursor)),
+          [event_size] "i"(sizeof(struct lk_el0_event)),
+          [resume] "i"(offsetof(struct lk_el0_native,fixed_resume_pc)),
+          [spsr] "i"(offsetof(struct lk_el0_native,fixed_spsr)),
+          [esr] "i"(offsetof(struct lk_el0_native,shadow.esr)),
+          [sp_el0] "i"(offsetof(struct lk_el0_native,shadow.sp_el0)),
+          [sp_el1] "i"(offsetof(struct lk_el0_native,shadow.sp_el1)),
+          [daif] "i"(offsetof(struct lk_el0_native,shadow.daif)));
+    _Static_assert(offsetof(struct lk_el0_native,event_cursor)==
+                       offsetof(struct lk_el0_native,event_end)+8 &&
+                   offsetof(struct lk_el0_native,pending_event)==
+                       offsetof(struct lk_el0_native,event_cursor)+8 &&
+                   offsetof(struct lk_el0_native,fixed_elr)==
+                       offsetof(struct lk_el0_native,fixed_spsr)+8,
+                   "paired entry fields");
+    _Static_assert(sizeof(struct lk_el0_event)==88 &&
+                   offsetof(struct lk_el0_event,result)==64 &&
+                   offsetof(struct lk_el0_event,completed)==72 &&
+                   offsetof(struct lk_el0_event,pc)==80,"IPC event layout");
+    size_t slots=(uintptr_t)end/4-(uintptr_t)begin/4;
+    memcpy(out,begin,slots*sizeof *out);
+    if(n->context->pstate&(1ull<<12))
+        out[((uintptr_t)ssbs-(uintptr_t)begin)/4]=0xb2740210u; /* orr x16,x16,#0x1000 */
+    uint32_t *jump=out+((uintptr_t)branch-(uintptr_t)begin)/4;
+    *jump=direct_branch((uintptr_t)jump,n->shadow.vbar+0x400);
+    return out+slots;
+}
