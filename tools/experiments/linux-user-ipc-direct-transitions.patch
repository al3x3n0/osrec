+static uint32_t *emit_fixed_return(struct lk_el0_native *n,uint32_t *out)
+{
+    const uint32_t *begin,*end,*ssbs;
+    uint64_t psr=FIXED_EL0_PSTATE|FIXED_DAIF_MASK|FIXED_PAN_MASK;
+    __asm__ volatile(
+        "b 9f\n"
+        "1:\n"
+        "stp x16,x17,[x18,%c[saved16]]\n"
+        "ldr x16,[x18,%c[site]]\n"
+        "ldr x17,[x18,%c[elr]]\n"
+        "sub x17,x17,x16\n"
+        "sub x17,x17,#4\n"
+        "cbnz x17,8f\n"
+        "ldr x17,[x18,%c[spsr]]\n"
+        "movz x16,%c[psr_low]\n"
+        "movk x16,%c[psr_high],lsl #16\n"
+        "bic x16,x17,x16\n"
+        "cbnz x16,8f\n"
+        "3: tbnz x17,#12,8f\n" /* Reject any change to the user SSBS bit. */
+        "and x16,x17,#0x3c0\n"
+        "str x16,[x18,%c[daif]]\n"
+        "ubfx x16,x17,#22,#1\n"
+        "str x16,[x18,%c[pan]]\n"
+        "mov x16,sp\n"
+        "str x16,[x18,%c[sp_el1]]\n"
+        "ldr x16,[x18,%c[sp_el0]]\n"
+        "mov sp,x16\n"
+        "str xzr,[x18,%c[mode]]\n"
+        "str xzr,[x18,%c[guest_x18]]\n"
+        "ldr x16,[x18,%c[emulated]]\n"
+        "add x16,x16,#1\n"
+        "str x16,[x18,%c[emulated]]\n"
+        "msr nzcv,x17\n"
+        "ldr x16,[x18,%c[thunk]]\n"
+        "br x16\n"
+        "8:\n"
+        "ldp x16,x17,[x18,%c[saved16]]\n"
+        "brk #0xf08\n"
+        "2:\n"
+        "9:\n"
+        "adr %0,1b\n"
+        "adr %1,2b\n"
+        "adr %2,3b\n"
+        : "=&r"(begin),"=&r"(end),"=&r"(ssbs)
+        : [saved16] "i"(offsetof(struct lk_el0_native,fixed_saved_x16)),
+          [site] "i"(offsetof(struct lk_el0_native,fixed_svc_pc)),
+          [elr] "i"(offsetof(struct lk_el0_native,shadow.elr)),
+          [spsr] "i"(offsetof(struct lk_el0_native,shadow.spsr)),
+          [psr_low] "i"(psr&65535),[psr_high] "i"(psr>>16),
+          [daif] "i"(offsetof(struct lk_el0_native,shadow.daif)),
+          [pan] "i"(offsetof(struct lk_el0_native,shadow.pan)),
+          [sp_el0] "i"(offsetof(struct lk_el0_native,shadow.sp_el0)),
+          [sp_el1] "i"(offsetof(struct lk_el0_native,shadow.sp_el1)),
+          [mode] "i"(offsetof(struct lk_el0_native,shadow.mode)),
+          [guest_x18] "i"(offsetof(struct lk_el0_native,fixed_guest_x18)),
+          [emulated] "i"(offsetof(struct lk_el0_native,shadow.emulated)),
+          [thunk] "i"(offsetof(struct lk_el0_native,fixed_return_thunk)));
+    size_t slots=(uintptr_t)end/4-(uintptr_t)begin/4;
+    memcpy(out,begin,slots*sizeof *out);
+    if(n->context->pstate&(1ull<<12))
+        out[((uintptr_t)ssbs-(uintptr_t)begin)/4]^=1u<<24; /* TBNZ to TBZ */
+    return out+slots;
+}
