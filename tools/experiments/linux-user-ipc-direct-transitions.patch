+/* The copied sequences use only local branches and offsets from x18.
+ * The low-address syscall gateways supply a site and a return landing pad. */
+static uint32_t *emit_fixed_entry(struct lk_el0_native *n,uint32_t *out)
+{
+    const uint32_t *begin,*end,*ssbs,*branch;
+    __asm__ volatile(
+        "b 9f\n"
+        "1:\n"
+        "str x15,[x18,%c[saved15]]\n"
+        "ldr x16,[x18,%c[count]]\n"
+        "ldr x17,[x18,%c[limit]]\n"
+        "sub x17,x17,x16\n"
+        "cbz x17,8f\n"
+        "mov x17,%c[event_size]\n"
+        "ldr x15,[x18,%c[events]]\n"
+        "madd x17,x16,x17,x15\n"
+        "add x16,x16,#1\n"
+        "str x16,[x18,%c[count]]\n"
+        "stp xzr,x8,[x17]\n"
+        "stp x0,x1,[x17,#16]\n"
+        "stp x2,x3,[x17,#32]\n"
+        "stp x4,x5,[x17,#48]\n"
+        "stp xzr,xzr,[x17,#64]\n"
+        "ldr x16,[x18,%c[site]]\n"
+        "str x16,[x17,#80]\n"
+        "str x17,[x18,%c[pending_event]]\n"
+        "add x16,x16,#4\n"
+        "str x16,[x18,%c[elr]]\n"
+        "mrs x16,nzcv\n"
+        "3: nop\n" /* Optional SSBS from the captured user PSTATE. */
+        "str x16,[x18,%c[spsr]]\n"
+        "mov x16,#0x56000000\n"
+        "str x16,[x18,%c[esr]]\n"
+        "mov x16,sp\n"
+        "str x16,[x18,%c[sp_el0]]\n"
+        "ldr x16,[x18,%c[sp_el1]]\n"
+        "mov sp,x16\n"
+        "sub x16,x16,#0x150\n"
+        "str x16,[x18,%c[pending_regs]]\n"
+        "mov x16,#0x3c0\n"
+        "str x16,[x18,%c[daif]]\n"
+        "mov x16,#1\n"
+        "str x16,[x18,%c[mode]]\n"
+        "ldr x16,[x18,%c[entries]]\n"
+        "add x16,x16,#1\n"
+        "str x16,[x18,%c[entries]]\n"
+        "ldr x15,[x18,%c[saved15]]\n"
+        "ldp x16,x17,[x18,%c[saved16]]\n"
+        "4: nop\n" /* Direct branch to the captured EL0 vector. */
+        "8:\n"
+        "ldr x15,[x18,%c[saved15]]\n"
+        "ldp x16,x17,[x18,%c[saved16]]\n"
+        "brk #0xf07\n"
+        "2:\n"
+        "9:\n"
+        "adr %0,1b\n"
+        "adr %1,2b\n"
+        "adr %2,3b\n"
+        "adr %3,4b\n"
+        : "=&r"(begin),"=&r"(end),"=&r"(ssbs),"=&r"(branch)
+        : [saved15] "i"(offsetof(struct lk_el0_native,fixed_saved_x15)),
+          [saved16] "i"(offsetof(struct lk_el0_native,fixed_saved_x16)),
+          [count] "i"(offsetof(struct lk_el0_native,event_count)),
+          [limit] "i"(offsetof(struct lk_el0_native,fixed_event_limit)),
+          [event_size] "i"(sizeof(struct lk_el0_event)),
+          [events] "i"(offsetof(struct lk_el0_native,events)),
+          [site] "i"(offsetof(struct lk_el0_native,fixed_svc_pc)),
+          [pending_event] "i"(offsetof(struct lk_el0_native,pending_event)),
+          [pending_regs] "i"(offsetof(struct lk_el0_native,pending_regs)),
+          [elr] "i"(offsetof(struct lk_el0_native,shadow.elr)),
+          [spsr] "i"(offsetof(struct lk_el0_native,shadow.spsr)),
+          [esr] "i"(offsetof(struct lk_el0_native,shadow.esr)),
+          [sp_el0] "i"(offsetof(struct lk_el0_native,shadow.sp_el0)),
+          [sp_el1] "i"(offsetof(struct lk_el0_native,shadow.sp_el1)),
+          [daif] "i"(offsetof(struct lk_el0_native,shadow.daif)),
+          [mode] "i"(offsetof(struct lk_el0_native,shadow.mode)),
+          [entries] "i"(offsetof(struct lk_el0_native,shadow.entries)));
+    _Static_assert(sizeof(struct lk_el0_event)==88 &&
+                   offsetof(struct lk_el0_event,result)==64 &&
+                   offsetof(struct lk_el0_event,pc)==80,"IPC event layout");
+    size_t slots=(uintptr_t)end/4-(uintptr_t)begin/4;
+    memcpy(out,begin,slots*sizeof *out);
+    if(n->context->pstate&(1ull<<12))
+        out[((uintptr_t)ssbs-(uintptr_t)begin)/4]=0xb2740210u; /* orr x16,x16,#0x1000 */
+    uint32_t *jump=out+((uintptr_t)branch-(uintptr_t)begin)/4;
+    *jump=direct_branch((uintptr_t)jump,n->shadow.vbar+0x400);
+    return out+slots;
+}
