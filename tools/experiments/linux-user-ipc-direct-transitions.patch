+static void expect_word(struct lk_el0_native *n,uint64_t pc,uint32_t expected)
+{
+    uint64_t attrs=0,pa=translate(n,pc,0,&attrs);
+    uint32_t *word=pa&1?NULL:physical(n,pa+(pc&4095),4);
+    if(!word || *word!=expected)
+        stop(OSREC_STOP_UNSUPPORTED,pc,expected,pa);
+}
