+static uint32_t *emit_fixed_return(struct lk_el0_native *n,uint32_t *out)
+{
+    /* Emit both SSBS forms so the selected stub only normalizes bits
+     * which differ from zero in the captured state. */
+    const uint32_t *without_ssbs,*with_ssbs,*templates_end;
+    __asm__ volatile(
+        "b 9f\n"
+        ".macro ipc_return ssbs\n"
+        "stp x16,x17,[x18,%c[saved16]]\n"
+        "ldp x17,x16,[x18,%c[elr]]\n"
+        "sub x17,x17,x16\n"
+        "cbnz x17,8f\n"
+        "ldr x17,[x18,%c[spsr]]\n"
+        "and x16,x17,#0xffffffff0fffffff\n" /* Ignore NZCV. */
+        ".if \\ssbs\n"
+        "eor x16,x16,#0x1000\n" /* Normalize the captured SSBS bit. */
+        ".endif\n"
+        "cbnz x16,5f\n"
+        "stp xzr,xzr,[x18,%c[daif]]\n"
+        "msr nzcv,x17\n"
+        "6: ldr x16,[x18,%c[pending_event]]\n"
+        "cbz x16,8f\n"
+        "mov x17,#1\n"
+        "stp x0,x17,[x16,%c[result]]\n"
+        "mov x16,sp\n"
+        "str x16,[x18,%c[sp_el1]]\n"
+        "ldp x17,x16,[x18,%c[thunk]]\n"
+        "mov sp,x16\n"
+        "str xzr,[x18,%c[pending_event]]\n"
+        "br x17\n"
+        "5: and x16,x16,#0xfffffffffffffc3f\n" /* Ignore DAIF. */
+        "and x16,x16,#0xffffffffffbfffff\n" /* Ignore PAN. */
+        "cbnz x16,8f\n" /* Reject changes to SSBS and all other bits. */
+        "msr nzcv,x17\n"
+        "and x16,x17,#0x3c0\n"
+        "ubfx x17,x17,#22,#1\n"
+        "stp x16,x17,[x18,%c[daif]]\n"
+        "b 6b\n"
+        "8:\n"
+        "ldp x16,x17,[x18,%c[saved16]]\n"
+        "brk #0xf08\n"
+        ".endm\n"
+        "1: ipc_return 0\n"
+        "2: ipc_return 1\n"
+        "3:\n"
+        ".purgem ipc_return\n"
+        "9:\n"
+        "adr %0,1b\n"
+        "adr %1,2b\n"
+        "adr %2,3b\n"
+        : "=&r"(without_ssbs),"=&r"(with_ssbs),"=&r"(templates_end)
+        : [saved16] "i"(offsetof(struct lk_el0_native,fixed_saved_x16)),
+          [elr] "i"(offsetof(struct lk_el0_native,fixed_elr)),
+          [pending_event] "i"(offsetof(struct lk_el0_native,pending_event)),
+          [result] "i"(offsetof(struct lk_el0_event,result)),
+          [spsr] "i"(offsetof(struct lk_el0_native,fixed_spsr)),
+          [daif] "i"(offsetof(struct lk_el0_native,shadow.daif)),
+          [sp_el1] "i"(offsetof(struct lk_el0_native,shadow.sp_el1)),
+          [thunk] "i"(offsetof(struct lk_el0_native,fixed_return_thunk)));
+    _Static_assert(offsetof(struct lk_el0_native,fixed_resume_pc)==
+                       offsetof(struct lk_el0_native,fixed_elr)+8 &&
+                   offsetof(struct lk_el0_native,shadow.sp_el0)==
+                       offsetof(struct lk_el0_native,fixed_return_thunk)+8 &&
+                   offsetof(struct osrec_shadow,pan)==offsetof(struct osrec_shadow,daif)+8,
+                   "paired return fields");
+    int ssbs=(n->context->pstate&(1ull<<12))!=0;
+    const uint32_t *begin=ssbs?with_ssbs:without_ssbs;
+    const uint32_t *end=ssbs?templates_end:with_ssbs;
+    size_t slots=(uintptr_t)end/4-(uintptr_t)begin/4;
+    memcpy(out,begin,slots*sizeof *out);
+    return out+slots;
+}
