+        slot[0]=pair_q(16,17,saved,0);
+        slot[1]=0x58000010u|(7u<<5); /* ldr x16, slot[8] */
+        slot[2]=0x10000011u|(4u<<5); /* adr x17, slot[6] */
+        slot[3]=pair_q(16,17,site,0);
+        slot[4]=0x58000010u|(6u<<5); /* ldr x16, slot[10] */
+        slot[5]=0xd61f0200u;         /* br x16 */
+        slot[6]=pair_q(16,17,saved,1);
+        slot[7]=direct_branch((uintptr_t)(slot+7),a->pc+4);
+        uint64_t address=(uintptr_t)entry;
+        uint64_t resume=a->pc+4;
+        memcpy(slot+8,&resume,sizeof resume);
+        memcpy(slot+10,&address,sizeof address);
+    }
 }

