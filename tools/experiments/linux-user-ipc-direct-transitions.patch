+/* x18 is an anchor in this capture. Preserve its guest value separately
+ * at every executed use from the audited IPC instruction trace. */
+static uint32_t *prepare_fixed_x18(struct lk_el0_native *n,uint32_t *out)
+{
+    const size_t guest=offsetof(struct lk_el0_native,fixed_guest_x18);
+    const size_t saved=offsetof(struct lk_el0_native,fixed_saved_x16);
+    static const struct {
+        uint64_t pc;
+        uint32_t original, replacement;
+        int reads_x18, writes_x18;
+    } sites[]={
+        {0x80008029f198ull,0x2a0c03f2u,0x2a0c03f0u,0,1}, /* mov w18, w12 */
+        {0x80008029f1a0ull,0x92401e52u,0x92401e10u,1,1}, /* and x18, x18, #0xff */
+        {0x80008029f1acull,0x4a120222u,0x4a100222u,1,0}, /* eor w2, w17, w18 */
+        {0x8000802ef620ull,0x121e7852u,0x121e7850u,0,1}, /* and w18, w2, #... */
+        {0x8000802fccccull,0x52804012u,0x52804010u,0,1}, /* mov w18, #512 */
+    };
+    expect_word(n,0x800080011368ull,0xa9094ff2u);
+    expect_word(n,0x8000800113c8ull,0xaa1f03f2u);
+    expect_word(n,0x800080012120ull,0xa9494ff2u);
+    /* Guest userspace x18 is zero in the fixed IPC trace. */
+    patch_instruction(n,0x800080011368ull,0xa9094fffu);
+    patch_instruction(n,0x8000800113c8ull,store_q(31,SHADOW_BASE,guest));
+    patch_instruction(n,0x800080012120ull,0xa9494fffu);
+    for(size_t i=0;i<sizeof sites/sizeof *sites;i++) {
+        uint64_t pc=sites[i].pc;
+        expect_word(n,pc,sites[i].original);
+        patch_instruction(n,pc,direct_branch(pc,(uintptr_t)out));
+        *out++=store_q(16,SHADOW_BASE,saved);
+        if(sites[i].reads_x18)*out++=load_q(16,SHADOW_BASE,guest);
+        *out++=sites[i].replacement;
+        if(sites[i].writes_x18)*out++=store_q(16,SHADOW_BASE,guest);
+        *out++=load_q(16,SHADOW_BASE,saved);
+        *out=direct_branch((uintptr_t)out,pc+4);
+        ++out;
+    }
+    return out;
+}
